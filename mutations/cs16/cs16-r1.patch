 1 file changed, 3 insertions(+), 3 deletions(-)

diff --git a/lib/src/combat/combat_rules.dart b/lib/src/combat/combat_rules.dart
index 2b89853..ca9a7d9 100644
--- a/lib/src/combat/combat_rules.dart
+++ b/lib/src/combat/combat_rules.dart
@@ -13,12 +13,12 @@ AttackOutcomeType classifyAttackRoll({
   if (naturalRoll >= critThreshold) {
     return AttackOutcomeType.criticalHit;
   }
-  if (naturalRoll == 1) {
-    return AttackOutcomeType.criticalMiss;
-  }
   if (totalToHit >= targetAc) {
     return AttackOutcomeType.hit;
   }
+  if (naturalRoll == 1) {
+    return AttackOutcomeType.criticalMiss;
+  }
   return AttackOutcomeType.miss;
 }
 
