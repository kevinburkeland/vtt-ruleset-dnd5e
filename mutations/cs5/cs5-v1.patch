---
 lib/src/combat/damage_adjustment.dart | 6 +++---
 1 file changed, 3 insertions(+), 3 deletions(-)

diff --git a/lib/src/combat/damage_adjustment.dart b/lib/src/combat/damage_adjustment.dart
index b7df688..be558d1 100644
--- a/lib/src/combat/damage_adjustment.dart
+++ b/lib/src/combat/damage_adjustment.dart
@@ -13,11 +13,11 @@ int adjustDamageForDefenses(
   if (immune) return 0;
 
   var adjusted = amount;
-  if (resistant) {
-    adjusted = adjusted ~/ 2;
-  }
   if (vulnerable) {
     adjusted = adjusted * 2;
   }
+  if (resistant) {
+    adjusted = adjusted ~/ 2;
+  }
   return math.max(0, adjusted);
 }
